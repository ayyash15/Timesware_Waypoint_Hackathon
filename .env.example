# Copy to .env to override defaults (docker compose also works with no .env at all).
MYSQL_DATABASE=waypoint
MYSQL_USER=waypoint
MYSQL_PASSWORD=waypoint_pw
MYSQL_ROOT_PASSWORD=root_pw
SECRET_KEY=change-me-long-random-string
SEED_PASSWORD=Waypoint@2026      # password of the four seeded accounts
DEMO_DATE=2026-10-06             # the seeded delivery day
DEMAND_SCALE=1.8                 # >1 makes the seeded day exceed capacity (shows deferrals)
WORKSHOP_COUNT=4                 # vehicles in the workshop on the demo day
ENFORCE_CUTOFF=0                 # 1 = reject/roll over orders after 16:00 Sri Lanka time
DEMO_LOGIN=1                     # 1 = each role page signs in as its seeded account (the design has no login screen)
